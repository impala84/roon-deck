#!/usr/bin/env python3
"""Reads the newest stable "## X.Y.Z Alpine" entry from CHANGELOG.md and checks the version files agree.

  tools/stable-release-info check          exit non-zero unless the repo is ready for that stable release
  tools/stable-release-info notes FILE     write the release notes for it to FILE
Prints the version on success. Used by the "Alpine verification" workflow when it publishes a stable release.
"""
import re, sys

text = open("CHANGELOG.md", encoding="utf-8").read()
matches = list(re.finditer(r"^## (\d+\.\d+\.\d+) Alpine — .+$", text, re.M))
if not matches:
    sys.exit("CHANGELOG.md has no stable '## X.Y.Z Alpine' entry.")
first = matches[0]
version = first.group(1)
# End of this entry: the next '## ' heading of any kind.
nxt = re.search(r"^## ", text[first.end():], re.M)
body = text[first.end(): first.end() + nxt.start()] if nxt else text[first.end():]
for path, pattern in (("pyproject.toml", 'version = "%s"'), ("src/pi_bus_time_display/__init__.py", '__version__ = "%s"')):
    if pattern % version not in open(path, encoding="utf-8").read():
        sys.exit(f"{path} is not at {version}; bump the version files in the same commit as the changelog entry.")
if len(sys.argv) > 2 and sys.argv[1] == "notes":
    open(sys.argv[2], "w", encoding="utf-8").write(body.strip() + "\n")
print(version)
