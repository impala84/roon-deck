#!/usr/bin/env python3
"""Publish the next Beta release in one step.

Write the new entry at the top of CHANGELOG.md first:

    ## 1.1.8-beta.1 Alpine — 27 October 2026

    - What changed, in plain words.

Then run:

    tools/release-beta            # bump versions, check, commit, push, release
    tools/release-beta --dry-run  # show what would happen, change nothing

The script reads the version from that top entry, writes it into every file that
carries the version, commits and rebases onto the beta branch, runs
`tools/check fast` on that final code, then pushes (never forced). GitHub
publishes only after that commit passes baseline; this helper confirms publication.
"""
import json
import re
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BRANCH = "main"
REPO = "impala84/roon-deck"
# Releases from beta.92 are tagged vX.Y.Z-beta.N. Devices running beta.88 or
# earlier only see "-alpine" tags; beta.89 and later accept both.
TAG_SUFFIX = ""
HEADING = re.compile(r"^## ((?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)-beta\.(\d+)) Alpine — .+$", re.M)


def run(*cmd, capture=False):
    print("$", " ".join(cmd), flush=True)
    result = subprocess.run(cmd, cwd=ROOT, text=True, capture_output=capture)
    if result.returncode:
        sys.exit(f"Stopped: {' '.join(cmd)} failed ({result.returncode}).\n{result.stderr if capture else ''}")
    return result.stdout.strip() if capture else ""


def top_entry():
    text = (ROOT / "CHANGELOG.md").read_text(encoding="utf-8")
    matches = list(HEADING.finditer(text))
    if not matches:
        sys.exit("CHANGELOG.md has no '## X.Y.Z-beta.N Alpine — date' entry at the top.")
    first = matches[0]
    if re.search(r"^## ", text, re.M).start() != first.start():
        sys.exit("Add the new beta release entry above the current stable release.")
    next_heading = re.search(r"^## ", text[first.end():], re.M)
    end = first.end() + next_heading.start() if next_heading else len(text)
    return first.group(1), text[first.start():end].strip()


def current_version():
    text = (ROOT / "pyproject.toml").read_text(encoding="utf-8")
    return re.search(r'^version = "([^"]+)"', text, re.M).group(1)


def sub_once(path, pattern, replacement, count=1):
    file = ROOT / path
    text = file.read_text(encoding="utf-8")
    new, n = re.subn(pattern, replacement, text, count=count, flags=re.M)
    if n != count:
        sys.exit(f"{path}: expected {count} version match(es), found {n}.")
    file.write_text(new, encoding="utf-8")


def bump(old, new):
    esc = re.escape(old)
    sub_once("pyproject.toml", rf'^version = "{esc}"', f'version = "{new}"')
    sub_once("src/pi_bus_time_display/__init__.py", rf'__version__ = "{esc}"', f'__version__ = "{new}"')
    sub_once("README.md", rf"\*\*{esc}\*\*", f"**{new}**")
    sub_once("roon-controller/package.json", rf'"version": "{esc}"', f'"version": "{new}"')
    sub_once("roon-controller/package-lock.json", rf'"version": "{esc}"', f'"version": "{new}"', count=2)


def version_order(value):
    match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)(?:-beta\.(\d+))?", value)
    if not match: sys.exit("Unsupported release version.")
    return tuple(int(match[i]) for i in (1, 2, 3)) + (1 if match[4] is None else 0, int(match[4] or 0))


def wait_for_publication(tag, source_sha):
    """Observe the existing checks/publisher; never create an unchecked release."""
    deadline = time.monotonic() + 600
    while time.monotonic() < deadline:
        runs = json.loads(run("gh", "run", "list", "--repo", REPO, "--workflow", "checks.yml",
                              "--commit", source_sha, "--event", "push", "--limit", "5",
                              "--json", "databaseId,status,conclusion", capture=True))
        if runs:
            baseline = runs[0]
            run("gh", "run", "watch", str(baseline["databaseId"]), "--repo", REPO, "--exit-status")
            break
        time.sleep(2)
    else:
        sys.exit("No baseline run appeared for this commit. Nothing was published by this helper.")
    while time.monotonic() < deadline:
        listing = json.loads(run("gh", "release", "list", "--repo", REPO, "--limit", "10",
                                 "--json", "tagName", capture=True))
        if tag in {item["tagName"] for item in listing}:
            actual = run("gh", "api", f"repos/{REPO}/commits/{tag}", "--jq", ".sha", capture=True)
            if actual != source_sha:
                sys.exit(f"{tag} points at a different commit; expected {source_sha}, got {actual}.")
            return
        time.sleep(2)
    sys.exit("Baseline passed, but publication was not confirmed. Check Publish beta release in GitHub Actions.")


def main():
    dry = "--dry-run" in sys.argv
    version, notes = top_entry()
    old = current_version()
    tag = f"v{version}{TAG_SUFFIX}"
    print(f"Current version {old}; changelog entry {version}; tag {tag}")

    if run("git", "branch", "--show-current", capture=True) != BRANCH:
        sys.exit(f"Switch to the {BRANCH} branch first.")
    if version_order(version) <= version_order(old) and version != old:
        sys.exit("The changelog entry is older than the current version.")
    published = json.loads(run("gh", "release", "list", "--repo", REPO, "--limit", "5",
                               "--json", "tagName", capture=True))
    if tag in {r["tagName"] for r in published}:
        sys.exit(f"{tag} is already published. Add a new changelog entry first.")
    if dry:
        print("Dry run: would bump, check, commit, push and publish.\n\n" + notes)
        return

    if version != old:
        bump(old, version)
    run("git", "add", "-A", "--", ":!roon-deck")
    if run("git", "status", "--porcelain", "--untracked-files=no", capture=True):
        first_line = notes.splitlines()[2] if len(notes.splitlines()) > 2 else "changes"
        run("git", "commit", "-m", f"Release {version} Alpine: {first_line.lstrip('- ')[:70]}")
    run("git", "pull", "--rebase", "origin", BRANCH)
    if top_entry() != (version, notes) or current_version() != version:
        sys.exit("The rebase changed the release version or notes. Review them before releasing.")
    run("tools/check", "fast")
    source_sha = run("git", "rev-parse", "HEAD", capture=True)
    run("git", "push", "origin", f"HEAD:{BRANCH}")
    wait_for_publication(tag, source_sha)
    print(f"\nPublished {tag}. Install it from Settings → Software on the Beta channel.")


if __name__ == "__main__": main()
